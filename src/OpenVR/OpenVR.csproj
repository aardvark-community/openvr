<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputPath>..\..\bin\$(Configuration)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\headers\openvr_api.cs" Link="openvr_api.cs" />
  </ItemGroup>
  <Target Name="CopyWindowsLibrary" BeforeTargets="PackNativeDependencies">
    <Copy
      SourceFiles="$(ProjectDir)..\..\bin\win64\openvr_api.dll"
      DestinationFolder="$(ProjectDir)..\..\lib\Native\OpenVR\windows\AMD64\"
      SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyLinuxLibrary" BeforeTargets="PackNativeDependencies">
    <Copy
      SourceFiles="$(ProjectDir)..\..\bin\linux64\libopenvr_api.so"
      DestinationFolder="$(ProjectDir)..\..\lib\Native\OpenVR\linux\AMD64\"
      SkipUnchangedFiles="true" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>